<?xml version="1.0"?>
<launch>
    <!-- Launch PX4 SITL and spawn UAV -->

    <!-- Vehicle pose arguments -->
    <arg name="x" default="0"/>
    <arg name="y" default="0"/>
    <arg name="z" default="0"/>
    <arg name="R" default="0"/>
    <arg name="P" default="0"/>
    <arg name="Y" default="0"/>
    <arg name="vehicle_name" default="uav"/>
    <arg name="ID" default="1"/>
    <arg name="interactive" default="true"/>
    <!-- Vehicle model and config arguments -->
    <arg name="est" default="ekf2"/>
    <arg name="vehicle" default="iris_depth_camera"/>

    <env name="PX4_SIM_MODEL" value="gazebo-classic_$(arg vehicle)" /> <!-- Set the vehicle model! -->
    <env name="PX4_ESTIMATOR" value="$(arg est)" />

    <arg name="sdf" default="$(find uvify_description)/sdf/$(arg vehicle)/$(arg vehicle).sdf"/>
    
    <!-- NO USE -->
    <arg name="mavlink_udp_port" default="$(eval 14560 + arg('ID'))"/>
    <arg name="mavlink_tcp_port" default="$(eval 4560 + arg('ID'))"/>
    <arg name="gst_udp_port" default="$(eval 5600 + arg('ID'))"/>
    <arg name="video_uri" default="$(eval 5600 + arg('ID'))"/>
    <arg name="mavlink_cam_udp_port" default="$(eval 14530 + arg('ID'))"/>
    <arg name="mavlink_id" value="$(eval 1 + arg('ID'))" />

    <arg name="cmd" default="$(find mavlink_sitl_gazebo)/scripts/jinja_gen.py --stdout --mavlink_id=$(arg mavlink_id) --mavlink_udp_port=$(arg mavlink_udp_port) --mavlink_tcp_port=$(arg mavlink_tcp_port) --gst_udp_port=$(arg gst_udp_port) --video_uri=$(arg video_uri) --mavlink_cam_udp_port=$(arg mavlink_cam_udp_port) $(find uvify_description)/sdf/$(arg vehicle)/$(arg vehicle).sdf.jinja $(find uvify_description)"/>
    <param command="$(arg cmd)" name="sdf_$(arg vehicle)$(arg ID)"/>
    <!-- PX4 SITL -->
    <arg unless="$(arg interactive)" name="px4_command_arg1" value=""/>
    <arg     if="$(arg interactive)" name="px4_command_arg1" value="-d"/>
    <node name="sitl_$(arg ID)" pkg="px4" type="px4" output="screen" args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i $(arg ID) -w sitl_$(arg vehicle)_$(arg ID) $(arg px4_command_arg1)">
    </node>
    <!-- spawn vehicle -->
    <!-- <node name="$(arg vehicle_name)_$(arg ID)_spawn" output="screen" pkg="gazebo_ros" type="spawn_model" args="-sdf -file $(arg sdf) -model $(arg vehicle_name)$(arg ID) -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg R) -P $(arg P) -Y $(arg Y)"/> -->
    <node name="$(arg vehicle_name)_$(arg ID)_spawn" output="screen" pkg="gazebo_ros" type="spawn_model" 
          args="-sdf -param sdf_$(arg vehicle)$(arg ID) -model $(arg vehicle_name)$(arg ID) -x $(arg x) -y $(arg y) -z $(arg z) -R $(arg R) -P $(arg P) -Y $(arg Y)"/>

    <node pkg="tf" type="static_transform_publisher" name="tf_camera" args="0.1 0 0.0 -1.57 0 -1.57 $(arg vehicle_name)$(arg ID)/base_link $(arg vehicle_name)$(arg ID)/camera_link 33"/>
    <!-- Camera Pose Publisher -->
    <node pkg="uvify_sitl" name="camera_pose_publisher" type="camera_pose_publisher" output="screen">
        <param name="parent_frame" value="world" />
        <param name="child_frame" value="$(arg vehicle_name)$(arg ID)/camera_link" />
        <param name="pose_topic" value="$(arg vehicle_name)$(arg ID)/camera/pose" />
    </node>

</launch>
